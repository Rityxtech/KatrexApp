rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ─── Helper Functions ───────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ─── Gift Card Images ───────────────────────────────────
    // Users can upload and read their own gift card images.
    // File path: giftcard_images/{uid}/{fileName}

    match /giftcard_images/{uid}/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.size < 10 * 1024 * 1024 // Max 10MB
        && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(uid);
    }

    // ─── KYC Documents ──────────────────────────────────────
    // Users can upload and read their own KYC documents.
    // File path: kyc_documents/{uid}/{fileName}

    match /kyc_documents/{uid}/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.size < 10 * 1024 * 1024 // Max 10MB
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
      allow delete: if isOwner(uid);
    }

    // ─── User Avatars ───────────────────────────────────────
    // Users can upload and read their own avatar.
    // File path: avatars/{uid}/avatar.jpg

    match /avatars/{uid}/{fileName} {
      allow read: if isSignedIn(); // Any signed-in user can view avatars
      allow write: if isOwner(uid)
        && request.resource.size < 5 * 1024 * 1024 // Max 5MB
        && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(uid);
    }

    // ─── Default: Deny All ──────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
